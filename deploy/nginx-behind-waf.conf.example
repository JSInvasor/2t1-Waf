# 2t1.online — WAF arkasındaki nginx
# Akış:  Cloudflare → WAF (:443 TLS) → BU NGINX (127.0.0.1:8080 düz HTTP) → app
#
# Önemli değişiklik: nginx artık 443/TLS dinlemiyor — onu WAF aldı.
# nginx sadece localhost:8080'de düz HTTP dinler ve uygulamana proxy_pass eder.
# Böylece dışarıdan nginx'e doğrudan erişilemez, her şey WAF'tan geçmek zorunda.

# --- Cloudflare gerçek-IP geri kazanımı (opsiyonel ama önerilir) -------------
# WAF gerçek ziyaretçi IP'sini X-Forwarded-For ve X-Real-IP olarak nginx'e
# zaten iletiyor (waf-proxy bunu kendisi ekliyor). Bu yüzden nginx'te
# log/uygulama gerçek IP'yi görmek için sadece WAF'ı güvenilir say:
set_real_ip_from 127.0.0.1;
real_ip_header X-Real-IP;          # WAF "x-real-ip" header'ı ile gönderir
real_ip_recursive off;

upstream app_2t1 {
    # ⇩⇩ KENDİ UYGULAMANI BURAYA YAZ ⇩⇩
    # PHP-FPM/WordPress ise genelde bir php-fpm socket'i + ayrı location gerekir;
    # Node/Python/Go ise uygulamanın dinlediği port:
    server 127.0.0.1:3000;         # ÖRNEK — kendi app portunla değiştir
    keepalive 32;
}

server {
    # Sadece localhost, sadece düz HTTP. Dışarı kapalı.
    listen 127.0.0.1:8080;
    server_name 2t1.online www.2t1.online;

    # Yükleme boyutu — WAF'taki max_body_bytes (1 MiB) ile uyumlu tut.
    client_max_body_size 1m;

    access_log /var/log/nginx/2t1.access.log;
    error_log  /var/log/nginx/2t1.error.log;

    location / {
        proxy_pass http://app_2t1;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # WAF'ın ilettiği başlıkları uygulamaya geçir:
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;     # real_ip ile gerçek ziyaretçi
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;            # zincirin başı hep https
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
    }
}
